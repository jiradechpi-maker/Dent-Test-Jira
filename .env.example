# URL of the Gotenberg service that converts .docx → .pdf (LibreOffice headless).
# Local: `docker compose up -d gotenberg` then use http://localhost:3001
# Leave empty to disable PDF conversion — .docx download still works.
GOTENBERG_URL="http://localhost:3001"

# Optional basic-auth credentials if your Gotenberg instance is protected.
GOTENBERG_USERNAME=""
GOTENBERG_PASSWORD=""
