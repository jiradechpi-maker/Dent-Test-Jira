# URL of the Gotenberg service that converts .docx → .pdf (LibreOffice headless).
# Local: `docker compose up -d gotenberg` then use http://localhost:3001
# Leave empty to disable PDF conversion — .docx download still works.
GOTENBERG_URL="http://localhost:3001"

# Optional basic-auth credentials if your Gotenberg instance is protected.
GOTENBERG_USERNAME=""
GOTENBERG_PASSWORD=""

# ── Google Drive (read-only schedule sync) ─────────────────────────────
# Service account key (Google Cloud → IAM → Service accounts → Keys → JSON).
# Paste the whole JSON (or its base64). Then share each Drive file with the
# service account's client_email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# …or the two fields separately:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional: override the Drive files (defaults are the faculty's current files).
SCHEDULE_YEAR4_FILE_ID=""
INVIGILATION_FILE_ID=""
